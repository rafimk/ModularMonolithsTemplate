{
  "ConnectionStrings": {
    "Database": "Host=CompanyName.database;Port=5432;Database=CompanyName;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "CompanyName.redis:6379"
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [ "http://CompanyName.identity:8080/realms/CompanyName", "http://localhost:18080/realms/CompanyName" ]
    },
    "MetadataAddress": "http://CompanyName.identity:8080/realms/CompanyName/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "http://CompanyName.identity:9000/health/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "CompanyName.Modules.Attendance.Infrastructure.Outbox": "Warning",
        "CompanyName.Modules.Attendance.Infrastructure.Inbox": "Warning",
        "CompanyName.Modules.Events.Infrastructure.Outbox": "Warning",
        "CompanyName.Modules.Events.Infrastructure.Inbox": "Warning",
        "CompanyName.Modules.Ticketing.Infrastructure.Outbox": "Warning",
        "CompanyName.Modules.Ticketing.Infrastructure.Inbox": "Warning",
        "CompanyName.Modules.Users.Infrastructure.Outbox": "Warning",
        "CompanyName.Modules.Users.Infrastructure.Inbox": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://CompanyName.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "CompanyName.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://CompanyName.jaeger:4317"
}
